{
  "tools": [
    {
      "name": "web_search",
      "description": "Perform a web search using the local SearXNG instance and return search results.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query string.",
            "maxLength": 500
          },
          "categories": {
            "type": "string",
            "description": "Optional category (e.g. general, IT, science, news). Defaults to general."
          },
          "pageno": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Page number for pagination (default 1)."
          }
        },
        "required": ["query"]
      }
    }
  ]
}
