{
  "tools": [
    {
      "name": "search_web",
      "description": "Query Brave or DuckDuckGo for public web listings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "description": "Search term (max 500 characters)"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "Number of results to retrieve (max 10)"
          }
        },
        "required": ["query"]
      }
    },
    {
      "name": "fetch_url",
      "description": "Retrieve content of a remote URL. Strictly enforces HTTPS.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://",
            "description": "The target HTTPS URL to fetch (HTTP is blocked)"
          }
        },
        "required": ["url"]
      }
    }
  ]
}
