{
  "tools": [
    {
      "name": "parse_csv",
      "description": "Ingest and parse a local CSV file into memory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1000
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 50000,
            "description": "Cap on rows to ingest (max 100,000)"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "parse_json",
      "description": "Ingest and parse a local JSON dataset into memory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "clean_data",
      "description": "Apply data hygiene rules (casing, timezone formatting, null-value replacement).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "null_strategy": {
            "type": "string",
            "enum": ["drop", "zero", "default"]
          },
          "case_columns": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "required": []
      }
    },
    {
      "name": "calculate_metrics",
      "description": "Compute statistical parameters (sums, averages, counts) on numeric columns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_columns": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "operations": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "enum": ["sum", "mean", "min", "max", "count"]
            }
          }
        },
        "required": ["target_columns", "operations"]
      }
    },
    {
      "name": "detect_anomalies",
      "description": "Run standard deviation outlier checks on numeric values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_column": {
            "type": "string",
            "maxLength": 100
          },
          "std_dev_threshold": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 5.0,
            "default": 3.0,
            "description": "Outlier threshold in standard deviations (1.0 to 5.0)"
          }
        },
        "required": ["target_column"]
      }
    },
    {
      "name": "export_summary",
      "description": "Export the calculated report or cleaned dataset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "output_path": {
            "type": "string",
            "maxLength": 1000
          },
          "format": {
            "type": "string",
            "enum": ["csv", "json", "markdown"]
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Row limit for export (max 500)"
          }
        },
        "required": ["output_path", "format"]
      }
    }
  ]
}
