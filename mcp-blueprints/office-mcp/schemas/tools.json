{
  "tools": [
    {
      "name": "read_office_file",
      "description": "Read raw text content from existing Word (.docx), PowerPoint (.pptx), Excel (.xlsx), or PDF files.",
      "inputSchema": {
        "properties": {
          "filePath": {
            "description": "Path to the document to read",
            "type": "string"
          }
        },
        "required": [
          "filePath"
        ],
        "type": "object"
      }
    },
    {
      "name": "write_excel_sheet",
      "description": "Create a new styled Microsoft Excel (.xlsx) workbook with multiple sheets, styled headers, and data rows.",
      "inputSchema": {
        "properties": {
          "data": {
            "properties": {
              "sheets": {
                "items": {
                  "properties": {
                    "columns": {
                      "items": {
                        "properties": {
                          "header": {
                            "type": "string"
                          },
                          "key": {
                            "type": "string"
                          },
                          "width": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "header",
                          "key"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "name": {
                      "type": "string"
                    },
                    "rows": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "style": {
                      "properties": {
                        "headerColor": {
                          "description": "Hex text color (e.g. FFFFFF)",
                          "type": "string"
                        },
                        "headerFill": {
                          "description": "Hex fill (e.g. 1F4E78)",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "name",
                    "columns",
                    "rows"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "sheets"
            ],
            "type": "object"
          },
          "filePath": {
            "description": "Path where the .xlsx file will be created",
            "type": "string"
          }
        },
        "required": [
          "filePath",
          "data"
        ],
        "type": "object"
      }
    },
    {
      "name": "write_pdf_document",
      "description": "Create a formatted PDF report with title, subtitle, divider lines, and text wrapping.",
      "inputSchema": {
        "properties": {
          "data": {
            "properties": {
              "paragraphs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "subtitle": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "paragraphs"
            ],
            "type": "object"
          },
          "filePath": {
            "description": "Path where the PDF will be created",
            "type": "string"
          }
        },
        "required": [
          "filePath",
          "data"
        ],
        "type": "object"
      }
    },
    {
      "name": "write_powerpoint_presentation",
      "description": "Create a styled PowerPoint (.pptx) presentation deck with slide titles, bullet points, and text cards.",
      "inputSchema": {
        "properties": {
          "data": {
            "properties": {
              "slides": {
                "items": {
                  "properties": {
                    "texts": {
                      "items": {
                        "properties": {
                          "bold": {
                            "type": "boolean"
                          },
                          "color": {
                            "type": "string"
                          },
                          "fontSize": {
                            "type": "number"
                          },
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "slides"
            ],
            "type": "object"
          },
          "filePath": {
            "description": "Path where the .pptx file will be created",
            "type": "string"
          }
        },
        "required": [
          "filePath",
          "data"
        ],
        "type": "object"
      }
    },
    {
      "name": "write_word_document",
      "description": "Create a new styled Microsoft Word (.docx) document with titles, sections, paragraphs, bullet points, and tables.",
      "inputSchema": {
        "properties": {
          "data": {
            "description": "Structured document content",
            "properties": {
              "sections": {
                "items": {
                  "properties": {
                    "content": {
                      "items": {
                        "properties": {
                          "headers": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "rows": {
                            "items": {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "type": "array"
                          },
                          "text": {
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "paragraph",
                              "bullet",
                              "table"
                            ],
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "heading": {
                      "type": "string"
                    },
                    "level": {
                      "description": "1 to 3",
                      "type": "number"
                    }
                  },
                  "required": [
                    "heading",
                    "content"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "subtitle": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "sections"
            ],
            "type": "object"
          },
          "filePath": {
            "description": "Path where the .docx file will be created",
            "type": "string"
          }
        },
        "required": [
          "filePath",
          "data"
        ],
        "type": "object"
      }
    }
  ]
}